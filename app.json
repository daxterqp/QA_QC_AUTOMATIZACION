{
  "expo": {
    "name": "Flow-QA/QC",
    "slug": "scua-qaqc",
    "version": "2.1.0",
    "newArchEnabled": false,
    "scheme": ["flow", "com.vxp.scua"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vxp.scua",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Flow QA/QC necesita acceso al GPS para registrar la ubicación de ensayos y trazabilidad operacional.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Flow QA/QC necesita acceso continuo al GPS (incluso en background) para registrar la trazabilidad operacional de equipos durante toda la jornada de trabajo.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vxp.scua",
      "versionCode": 30,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBJbqP-2rHM5SOqdw2SLbjPviP858pBf9s"
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Flow QA/QC necesita acceso a la cámara para capturar evidencias fotográficas.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-web-browser"
    ]
  }
}
